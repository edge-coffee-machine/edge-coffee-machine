# ====================================================
# 1. HARDWARE SETUP (Critical for ESP32-P4 EV Board)
# ====================================================
CONFIG_IDF_TARGET="esp32p4"

# Flash must be OPI 80MHz (Prevents "Store access fault" crashes)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_OPI=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM must be Octal (Required for 1024x600 Display)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# From your current config: Allow large tasks (like Face Rec) to use PSRAM
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y 

# ====================================================
# 2. FACE RECOGNITION REQUIREMENTS (Fixes xCoreID error)
# ====================================================
# These enable the Task List debug features used by 'who_task'
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Higher tick rate for smoother video/UI
CONFIG_FREERTOS_HZ=1000

CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_MIPI_RAW8_1024X600_30FPS=y
CONFIG_CAMERA_SC2336_MIPI_IF_FORMAT_INDEX_DEFAULT=11
# Disable DVP to avoid conflicts with MIPI
CONFIG_CAMERA_SC2336_DVP_RAW10_1280X720_30FPS=n

CONFIG_CAMERA_SC2336_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_SC2336_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="/components/who_cam/who_p4_cam/sc2336.json"

# Enable ESP Video components (these are the correct symbols)
CONFIG_ESP_VIDEO_ENABLE_ISP=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ESP_VIDEO_ENABLE_DATA_PREPROCESSING=y

# Disable DVP video device
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=n

# ====================================================
# 3. QT FOR MCUS REQUIREMENTS
# ====================================================
# Qt libraries are built without C++ exceptions
CONFIG_COMPILER_CXX_EXCEPTIONS=n

# Increase default stack sizes for Qt Initialization
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192

# ====================================================
# 4. PARTITIONS & LOGGING
# ====================================================
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y

# ==================================